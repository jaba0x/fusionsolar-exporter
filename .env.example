# FusionSolar web portal user. A dedicated read-only user is recommended.
# If the password contains # or $ wrap it in single quotes.
FUSIONSOLAR_USERNAME=
FUSIONSOLAR_PASSWORD=

# Login host for your region
FUSIONSOLAR_LOGIN_URL=https://eu5.fusionsolar.huawei.com

# Plant time zone as a UTC offset in hours
TIMEZONE_OFFSET_HOURS=0

POLL_INTERVAL_SECONDS=120
